# Dedicated Linux build runner for OrcaSlicer.
# Keep the general-purpose runner unchanged; this image layers project build
# prerequisites on top of the matching general-purpose image release.
ARG BASE_IMAGE=harbor.sirddail.net/arc/actions-runner:latest

# apt reads a pinned Ubuntu snapshot, never the live mirror (homelab#1981, D-051;
# design and tests: dvystrcil/homelab architecture/apt-snapshot-image-builds.md).
# A mirror mid-sync can't fail this build, and the packages added here depend on
# APT_SNAPSHOT, not on the minute the build ran.
#   - The pin is the repository itself: ubuntu.sources' URIs point at
#     <APT_SNAPSHOT_BASE>/<APT_SNAPSHOT>/. Not `--snapshot` or `Snapshot:`: those
#     still fetch the live mirror alongside the snapshot (the doc's trap 1).
#   - `apt-get update --error-on=any -o Acquire::Retries=3`: without
#     --error-on=any an unreachable source is a warning and apt carries on.
#   - APT_SNAPSHOT is written once, here. The weekly bump job (homelab#2426)
#     edits this line.
#   - APT_SNAPSHOT_BASE defaults to snapshot.ubuntu.com direct (local builds).
#     build.yaml passes the in-cluster apt-cacher-ng form,
#     http://apt-cacher-ng.arc-runner.svc.cluster.local:3142/HTTPS///snapshot.ubuntu.com/ubuntu.
#     The URL names the cache, so if the cache is down the build fails; nothing
#     falls back to the live mirror.
#   - Only the Ubuntu archive is pinned. The base image's third-party sources
#     (git-core PPA, cli.github.com) stay live (owner decision, D-051). The base
#     image itself (Dockerfile) keeps its live `apt-get upgrade -y`, a documented
#     exception in D-051.
#   - No TLS bootstrap: the base already has ca-certificates.
#   - tests/test-apt-snapshot.sh proves it builds with the live mirror blocked
#     and fails clearly with the snapshot source blocked.
ARG APT_SNAPSHOT=20261119T000000Z
ARG APT_SNAPSHOT_BASE=https://snapshot.ubuntu.com/ubuntu

FROM ${BASE_IMAGE}
ARG APT_SNAPSHOT
ARG APT_SNAPSHOT_BASE

USER root

# Aligned with scripts/linux.d/debian in the OrcaSlicer baseline branches.
# One image serves both baseline-2.4.2 and baseline-2.5.0, so it holds the
# union of their package lists (2.5.0 swapped libglew-dev for libgl-dev and
# added pkgconf, yasm and nasm; FFmpeg's configure refuses to build on x86_64
# without nasm). Ubuntu 24.04 uses the WebKitGTK 4.1 development package.
#
# The snapshot sources are used for this install only: the live ubuntu.sources
# is put back at the end of the same RUN, so the shipped image's apt config is
# the base's. The cache URL must not ship: OrcaSlicer jobs run under an egress
# policy that blocks every cluster address (arc-runners
# isolated/orcaslicer-egress.yaml), so a job's `sudo apt-get` could never
# reach it.
RUN cp /etc/apt/sources.list.d/ubuntu.sources /tmp/ubuntu.sources.live \
    && sed -i -E "s|^URIs: .*|URIs: ${APT_SNAPSHOT_BASE}/${APT_SNAPSHOT}/|" /etc/apt/sources.list.d/ubuntu.sources \
    && test "$(grep -c '^URIs: ' /etc/apt/sources.list.d/ubuntu.sources)" -ge 1 \
    && ! grep -rsE '^ *(deb |URIs:).*(archive|security)\.ubuntu\.com' /etc/apt/sources.list /etc/apt/sources.list.d/ \
    && apt-get update --error-on=any -o Acquire::Retries=3 \
    && apt-get install -y --no-install-recommends \
        autoconf \
        automake \
        build-essential \
        cmake \
        eglexternalplatform-dev \
        extra-cmake-modules \
        file \
        g++ \
        gettext \
        git \
        gstreamer1.0-gtk3 \
        libcurl4-openssl-dev \
        libdbus-1-dev \
        libgl-dev \
        libglew-dev \
        libgstreamerd-3-dev \
        libgtk-3-dev \
        libmspack-dev \
        libsecret-1-dev \
        libspnav-dev \
        libssl-dev \
        libtool \
        libudev-dev \
        libwebkit2gtk-4.1-dev \
        clang \
        lld \
        nasm \
        ninja-build \
        pkgconf \
        texinfo \
        wget \
        yasm \
    && mv /tmp/ubuntu.sources.live /etc/apt/sources.list.d/ubuntu.sources \
    && rm -rf /var/lib/apt/lists/*

# Catch missing GTK3 headers at image-build time, not during the OrcaSlicer job.
RUN dpkg-query -W -f='${Status}\n' libgtk-3-dev | grep -qx 'install ok installed' \
    && test -f /usr/include/gtk-3.0/gtk/gtk.h

USER runner
